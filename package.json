{
  "name": "inventry",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "c8 node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=node-reporter-sonarqube --test-reporter-destination=coverage/test-report.xml tests/*.test.js",
    "test:coverage": "npm run test && c8 check-coverage --lines 100 --branches 100 --functions 100",
    "start": "node server.js",
    "server": "nodemon server.js"
  },
  "c8": {
    "all": true,
    "reporter": ["text", "lcov"],
    "reports-dir": "coverage",
    "include": [
      "app.js",
      "server.js",
      "controllers/**/*.js",
      "middleware/**/*.js",
      "services/**/*.js",
      "modals/**/*.js",
      "routes/**/*.js",
      "utils/**/*.js"
    ]
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.3",
    "multer": "^2.4.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "node-reporter-sonarqube": "^1.0.3"
  }
}
